# Curiosity Passport — Commercial Multi-Tenant SaaS Environment Variables

# Supabase (Postgres Database & Realtime Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Transactional Email (Resend / SendGrid)
VITE_RESEND_API_KEY=re_your_api_key

# Cloudflare R2 / AWS S3 File Storage (for research PDFs and datasets)
VITE_STORAGE_BUCKET_URL=https://your-storage-bucket.r2.cloudflarestorage.com
